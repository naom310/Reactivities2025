// .vscode/launch.json
{
        "version": "0.2.0",
        "configurations": [
            {
                "name": ".NET Core Attach",
                "type": "coreclr",
                "request": "attach"
            },
            {
                "name": "Launch API",
                "type": "coreclr",
                "request": "launch",
                "preLaunchTask": "build",
                "program": "${workspaceFolder}/API/bin/Debug/net9.0/API.dll",
                "cwd": "${workspaceFolder}/API"
            }
        ]
}