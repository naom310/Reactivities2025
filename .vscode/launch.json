// .vscode/launch.json
{
        "version": "0.2.0",
        "configurations": [
            {
                "name": ".NET Core Attach",
                "type": "coreclr",
                "request": "attach"
            },
            {
                "name": "C#: API Debug",
                "type": "dotnet",
                "request": "launch",
                "projectPath": "${workspaceFolder}/API/API.csproj"
            },
            {
                "type": "chrome",
                "request": "launch",
                "name": "Depurar React en Chrome",
                "url": "https://localhost:3000",
                "webRoot": "${workspaceFolder}/src",
                "sourceMaps": true
            }
        ]
}